{
  "name": "multmanga",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MultManga - 本地漫画聚合工具：多源搜索、下载、书架管理与阅读",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"pnpm --filter @multmanga/server dev\" \"pnpm --filter @multmanga/web dev\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm --filter @multmanga/web build",
    "start": "pnpm --filter @multmanga/server start"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@11.7.0"
}
